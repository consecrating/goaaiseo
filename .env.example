# ============================================================================
# GOAAISEO environment template — copy to .env and fill in. Never commit .env.
# ============================================================================

# --- Core ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# --- Database (PostgreSQL 16 + pgvector + Timescale / Supabase) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goaaiseo
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (cache + BullMQ/Arq queues) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (raw HTML / snapshots / exports) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=goaaiseo
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Auth (Supabase Auth + Google OAuth for GSC/GA4/GBP scopes) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback
# scopes: webmasters.readonly, analytics.readonly, business.manage

# --- Google data APIs ---
GSC_BULK_EXPORT_DATASET=          # BigQuery dataset for unsampled GSC export
GA4_PROPERTY_ID=
BIGQUERY_PROJECT_ID=

# --- AI / LLM providers (agent + generation + embeddings) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
PERPLEXITY_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

# --- SERP / competitor data provider ---
SERP_PROVIDER_API_KEY=

# --- Crawler ---
CRAWLER_USER_AGENT=GOAAISEO-bot/1.0 (+https://goaaiseo.com/bot)
CRAWLER_MAX_CONCURRENCY=8
PLAYWRIGHT_HEADLESS=true

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
